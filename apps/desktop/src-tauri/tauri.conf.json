{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apex",
  "version": "0.4.0",
  "identifier": "com.justcallmebryan.apex",
  "build": {
    "beforeDevCommand": "cargo build -p apexd && mkdir -p src-tauri/binaries && cp ../../target/debug/apexd src-tauri/binaries/apexd-$(rustc -vV | sed -n 's|host: ||p') && chmod +x src-tauri/binaries/apexd-* && vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Apex",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/apexd"
    ]
  }
}
