{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apex",
  "version": "0.7.0",
  "identifier": "com.justcallmebryan.apex",
  "build": {
    "beforeDevCommand": "cargo build -p apexd && mkdir -p src-tauri/binaries && cp ../../target/debug/apexd src-tauri/binaries/apexd-$(rustc -vV | sed -n 's|host: ||p') && chmod +x src-tauri/binaries/apexd-* && vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Apex",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2NDhGQzY4OTExRjY4MjYKUldRbWFCK1JhUHhJUnJHMDF5Mmo4Z0FUaG5teW1XRU5jcTBLbWpKeWQydlNyWVhFTStMNjVWTzgK",
      "endpoints": [
        "https://github.com/sthbryan/Apex/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/apexd"
    ]
  }
}
